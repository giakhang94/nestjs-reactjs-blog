// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
enum Role {
  admin 
  author 
}

enum Status {
  published
  draft
  editing
  deleted
}
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id  Int  @id @default(autoincrement())
  email String @unique
  password String
  firstName String
  lastName String
  displayName String
  role Role @default(author)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //relationships
  posts Post[]
  comment Comment[]
  avatar Avatar? 
  @@fulltext([displayName])
}

model Avatar {
  id Int @id @default(autoincrement())
  url String
  public_id String
  user User @relation(fields: [userId], references: [id])
  userId Int @unique
}
//post and relevant models
model Post {
  id Int @id @default(autoincrement())
  title String
  preview_text String
  user User @relation(fields: [userId], references: [id])
  userId Int
  content String
  status Status
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  //relationships
  category Category @relation(fields: [cateId], references: [id])
  cateId Int
  thumbnail Thumbnail? 
  tags TagsOnPosts[]
  comment Comment[]
}

model Thumbnail {
  id Int @id @default(autoincrement())
  url String
  public_id String
  post Post @relation(fields: [postId], references: [id])
  postId Int @unique
}

model Tag {
  id Int @id @default(autoincrement())
  tag String @unique
  posts TagsOnPosts[]

  @@fulltext([tag])
}

model Category {
  id Int @id @default(autoincrement())
  category String @unique
  posts Post[]

  @@fulltext([category])
}

//Comment model is a particular modal that has it's own id field. 
//It's not a sub-table generated from n-n relationship between user table and post table
model Comment {
  id Int @id @default(autoincrement())
  post Post @relation(fields: [postId], references: [id])
  postId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  content String
  createdAt DateTime @default(now())

}
//sub tables
model TagsOnPosts {
  post Post @relation(fields: [postId], references: [id])
  postId Int
  tag Tag @relation(fields: [tagId], references: [id])
  tagId Int
  createdAt DateTime @default(now())
  @@id([postId, tagId])  
}

